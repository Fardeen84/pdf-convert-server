PORT=3000
# Shared secret the app sends in the x-api-key header. Leave empty ONLY for local testing.
API_KEY=change-me
MAX_FILE_MB=25
# How many conversions run at once (each LibreOffice run uses ~300-500 MB RAM)
MAX_JOBS=2
# Per-conversion timeout (seconds)
JOB_TIMEOUT_S=120
# Requests allowed per IP per minute
RATE_LIMIT_PER_MIN=20
PYTHON_BIN=python3
